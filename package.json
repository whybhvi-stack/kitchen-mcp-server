{
  "name": "kitchen-mcp-server",
  "version": "1.0.0",
  "description": "Kitchen MCP server for pantry, recipes, shopping, and timer tools.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "npm run typecheck && npm run build",
    "test:db": "npm run build && tsx --test tests-db/*.test.ts",
    "test:smoke": "tsx src/smoke-test.ts",
    "typecheck": "tsc --noEmit",
    "start:stdio": "node dist/stdio.js"
  },
  "keywords": ["mcp", "kitchen", "pantry", "recipes"],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "kitchen-mcp-server": "dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "body-parser": "^2.4.0"
  }
}
